# Rust / Cargo
/target/
**/target/
**/*.rs.bk
*.pdb

# Packaged builds
/dist/

# Makepad: generated by scripts/setup-makepad.sh (never commit the tree)
/vendor/makepad/
/vendor/makepad-full/
/vendor/*
!/vendor/.gitkeep
**/.makepad/

# Local runtime / scratch
/local/
*.log
*.tmp
*.temp

# Secrets / local env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Site deploy staging (Firebase)
sites/**/node_modules/
sites/**/firebase-debug.log
sites/**/.firebase/
sites/**/public/
